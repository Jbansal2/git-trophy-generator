{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env server.ts",
    "dev": "deno run --allow-net --allow-read --allow-env --watch server.ts",
    "cache": "deno cache server.ts",
    "test": "deno test --allow-net --allow-read --allow-env tests/",
    "test:watch": "deno test --allow-net --allow-read --allow-env --watch tests/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "imports": {
    "oak": "https://deno.land/x/oak@v12.6.1/mod.ts",
    "dotenv": "https://deno.land/std@0.208.0/dotenv/mod.ts"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-import-prefix",
        "prefer-const"
      ]
    }
  }
}
